#. TRANSLATORS: Error message: no tour with that ID exists
msgid "Unknown tour"
msgstr "Неизвестная экскурсия"

#. TRANSLATORS: Error message: only administrators may do this
msgid "Administrator privileges required"
msgstr "Требуются права администратора"

#. TRANSLATORS: Error message; %s is the language code that was refused, such as "en-US!"
#, php-format
msgid "Invalid language code: %s"
msgstr "Недопустимый код языка: %s"

#. TRANSLATORS: %s is a technical description of the problem, in English, such as "Step 2: title must be text"
#, php-format
msgid "Invalid step data: %s"
msgstr "Недопустимые данные шага: %s"

msgid "Import file is too large (at most 1 MB)"
msgstr "Файл импорта слишком большой (не более 1 МБ)"

#. TRANSLATORS: %s is PHP's own description of the JSON error, in English, such as "Syntax error"
#, php-format
msgid "Invalid JSON format: %s"
msgstr "Недопустимый формат JSON: %s"

msgid "Invalid import format: missing language or steps"
msgstr "Недопустимый формат импорта: не указан язык или шаги"

msgid "Failed to send telemetry report"
msgstr "Не удалось отправить отчёт телеметрии"

#. TRANSLATORS: %s is a technical description of the problem, in English, such as "audience must be everyone or new"
#, php-format
msgid "Invalid tour: %s"
msgstr "Недопустимая экскурсия: %s"

#. TRANSLATORS: Title of the checklist widget on the Dashboard
msgid "Getting started"
msgstr "Начало работы"

msgid "All done. You can remove this list under Customize."
msgstr "Всё готово. Этот список можно убрать через кнопку «Настроить»."

#. TRANSLATORS: Status (adjective): a task is finished, such as an AI translation or a checklist task
msgid "Completed"
msgstr "Завершено"

#. TRANSLATORS: Noun: tab on the administration page, the heading of the list of tours, and the entry in the user menu; keep it short
#. TRANSLATORS src/admin/ToursList.vue:4
#. TRANSLATORS src/personal/PersonalApp.vue:28
msgid "Tours"
msgstr "Экскурсии"

#. TRANSLATORS: Name of the Files app, as Nextcloud shows it in your language
msgid "Files"
msgstr "Файлы"

#. TRANSLATORS: Name of the Talk app, as Nextcloud shows it in your language
msgid "Talk"
msgstr "Конференции"

#. TRANSLATORS: Name of the Deck app, as Nextcloud shows it in your language
msgid "Deck"
msgstr "Карточки"

#. TRANSLATORS: Name of the Calendar app, as Nextcloud shows it in your language
msgid "Calendar"
msgstr "Календарь"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
msgid "📁 Welcome to Files"
msgstr "📁 Добро пожаловать в Файлы"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Files is where your work lives. Share a link instead of emailing attachments, so everyone works in the same copy.</p><p>In this tour you make a folder, see how to share it and learn how to undo mistakes.</p>"
msgstr "<p>В приложении Файлы хранится вся ваша работа. Вместо того чтобы пересылать вложения по почте, делитесь ссылкой — так все работают с одной и той же копией.</p><p>В этой экскурсии вы создадите папку, увидите, как ею поделиться, и узнаете, как исправлять ошибки.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
msgid "➕ Make a place for your work"
msgstr "➕ Место для вашей работы"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Let's start with a folder of your own: click <strong>New</strong>.</p><p>No New button? Open a folder you can add to, such as a project folder.</p>"
msgstr "<p>Начнём с собственной папки: нажмите <strong>Новый</strong>.</p><p>Нет кнопки «Новый»? Откройте папку, в которую можно добавлять файлы, например папку проекта.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
msgid "📤 Upload or create"
msgstr "📤 Загрузка и создание"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Here you upload files, or a whole folder at once, and create new documents to work on together.</p><p>For now, choose <strong>New folder</strong>.</p>"
msgstr "<p>Здесь можно загружать файлы или сразу целую папку, а также создавать документы для совместной работы.</p><p>А сейчас выберите <strong>Новая папка</strong>.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
msgid "✏️ Give it a name"
msgstr "✏️ Задайте название"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Name it after something you're working on now, so it's useful right away and others see what's inside.</p><p>Click <strong>Create</strong> first, then click <strong>Next</strong>.</p>"
msgstr "<p>Назовите её по тому, над чем вы сейчас работаете: так она сразу пригодится, а другие поймут, что внутри.</p><p>Сначала нажмите <strong>Создать</strong>, затем — <strong>Далее</strong>.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
msgid "🤝 Share a folder"
msgstr "🤝 Поделитесь папкой"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Now click the share icon next to your new folder. Could not make one? Any folder you can share will do.</p><p>The icon opens a panel that shows who has access. Nothing gets shared yet.</p>"
msgstr "<p>Теперь нажмите значок общего доступа рядом с новой папкой. Не получилось её создать? Подойдёт любая папка, которой вы можете поделиться.</p><p>Значок открывает панель, где видно, у кого есть доступ. Пока вы ничем не делитесь.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
msgid "👥 Colleagues and teams"
msgstr "👥 Коллеги и команды"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Type a colleague's name, a group or a team. Choose <strong>View only</strong> or <strong>Allow upload and editing</strong>, then click <strong>Save share</strong>.</p><p>Anything you add to the folder later is shared too. You do not have to share anything now.</p>"
msgstr "<p>Введите имя коллеги, название группы или команды. Выберите <strong>Для просмотра</strong> или <strong>Разрешить приём и редактирование</strong>, затем нажмите <strong>Сохранить общий ресурс</strong>.</p><p>Всё, что вы позже добавите в папку, тоже станет доступно. Сейчас делиться ничем не обязательно.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
msgid "🔗 Send a link, not a file"
msgstr "🔗 Отправляйте ссылку, а не файл"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Copy the <strong>Internal link</strong> into a chat or an email instead of attaching the file. Colleagues with access open this very folder, so nobody works on an old copy.</p><p>The link itself does not give anyone access.</p>"
msgstr "<p>Вместо того чтобы прикреплять файл, скопируйте ссылку из пункта <strong>Внутренняя ссылка</strong> в чат или письмо. Коллеги, у которых есть доступ, откроют именно эту папку, так что никто не будет работать со старой копией.</p><p>Сама ссылка никому не даёт доступа.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
msgid "🌐 People outside your organization"
msgstr "🌐 Люди вне вашей организации"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Someone at another organization? Type their email address above, or their federated cloud ID if they use Nextcloud too.</p><p>Or create a public link: its <strong>⋯</strong> menu › <strong>Customize link</strong> adds a password and an expiration date. Your organization may limit public links.</p>"
msgstr "<p>Человек из другой организации? Введите выше его адрес электронной почты или, если он тоже пользуется Nextcloud, идентификатор федеративного облака.</p><p>Или создайте общедоступную ссылку: в её меню <strong>⋯</strong> › <strong>Настроить ссылку</strong> можно задать пароль и срок действия. В вашей организации общедоступные ссылки могут быть ограничены.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
msgid "💬 Activity and comments"
msgstr "💬 События и комментарии"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>The <strong>Activity</strong> tab shows what happened to this item, such as who created, renamed or shared it.</p><p>You can also leave a comment there for everyone with access.</p>"
msgstr "<p>На вкладке <strong>События</strong> видно, что происходило с этим объектом: например, кто его создал, переименовал или поделился им.</p><p>Там же можно оставить комментарий для всех, у кого есть доступ.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
msgid "📥 Shared with you"
msgstr "📥 Доступное вам"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Everything shared with you or by you is under <strong>Shares</strong>. Folders shared with your group or project also show up in <strong>All files</strong>.</p><p>A share from another Nextcloud server may wait in <strong>Pending shares</strong>: open Shares with its arrow to accept it.</p>"
msgstr "<p>Всё, чем поделились с вами или вы сами, находится в разделе <strong>Общие ресурсы</strong>. Папки, открытые для вашей группы или проекта, видны и в разделе <strong>Все файлы</strong>.</p><p>Общий ресурс с другого сервера Nextcloud может ждать в разделе <strong>Ожидающие подтверждения</strong>: разверните «Общие ресурсы» стрелкой, чтобы принять его.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Files app; keep the emoji
#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "🗑️ Nothing is lost right away"
msgstr "🗑️ Ничего не пропадает сразу"

#. TRANSLATORS: Text of a step in the built-in tour of the Files app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Changed a file by mistake? In its details, <strong>Versions</strong> brings back an earlier one. Deleted something? It stays in <strong>Deleted files</strong> for a while.</p><p>That's it. Now drag your files into your folder, and send links instead of attachments.</p>"
msgstr "<p>Случайно изменили файл? В его сведениях на вкладке <strong>Версии</strong> можно вернуть прежнюю версию. Что-то удалили? Оно ещё какое-то время хранится в разделе <strong>Корзина</strong>.</p><p>Вот и всё. Теперь перетащите свои файлы в папку и отправляйте ссылки вместо вложений.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "💬 Welcome to Talk"
msgstr "💬 Добро пожаловать в «Конференции»"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Chat, calls and video meetings with your colleagues, right next to your files.</p><p>In this tour you set up a conversation for your team, add colleagues and see how calls, meetings and notifications work.</p>"
msgstr "<p>Чат, вызовы и видеовстречи с коллегами — прямо рядом с вашими файлами.</p><p>В этой экскурсии вы создадите обсуждение для своей команды, добавите коллег и увидите, как работают вызовы, встречи и уведомления.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "🚀 A conversation for your team"
msgstr "🚀 Обсуждение для вашей команды"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>A group conversation keeps a team's messages, files and calls in one place, instead of long email threads.</p><p>Let's make one: click the highlighted button. If it is not there, click <strong>Home</strong> at the top left.</p>"
msgstr "<p>В групповом обсуждении сообщения, файлы и вызовы команды собраны в одном месте, а не разбросаны по длинным цепочкам писем.</p><p>Давайте создадим его: нажмите выделенную кнопку. Если её нет, нажмите <strong>Домашняя страница</strong> вверху слева.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "✏️ Name it after real work"
msgstr "✏️ Назовите по реальной работе"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Type the name of a team, project or research group you work with, then click <strong>Next</strong>. Leave the other options as they are.</p><p>Already have a team conversation? Close this with ✕, then click <strong>Next</strong>.</p>"
msgstr "<p>Введите название команды, проекта или исследовательской группы, с которой вы работаете, затем нажмите <strong>Далее</strong>. Остальные параметры оставьте как есть.</p><p>Обсуждение для команды уже есть? Закройте это окно кнопкой ✕, затем нажмите <strong>Далее</strong>.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "✅ Create it"
msgstr "✅ Создайте его"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Click the highlighted button to create the conversation.</p>"
msgstr "<p>Нажмите выделенную кнопку, чтобы создать обсуждение.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "👥 Add your colleagues"
msgstr "👥 Добавьте коллег"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>In <strong>Participants</strong> on the right (open the sidebar if needed), type a colleague's or group's name and pick them. They get a notification.</p><p>External partners? Invite them by email in a separate conversation, if your organization allows guests.</p>"
msgstr "<p>В разделе <strong>Участники</strong> справа (при необходимости откройте боковую панель) введите имя коллеги или название группы и выберите нужный вариант. Они получат уведомление.</p><p>Внешние партнёры? Пригласите их по электронной почте в отдельное обсуждение, если ваша организация разрешает гостей.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "✍️ Say what it is for"
msgstr "✍️ Расскажите, для чего оно"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Write a first message, for example what this conversation is for, and send it.</p><p>The <strong>+</strong> button shares one of your files, so everyone works in the same copy.</p>"
msgstr "<p>Напишите первое сообщение, например о том, для чего это обсуждение, и отправьте его.</p><p>Кнопка <strong>+</strong> позволяет поделиться одним из ваших файлов, чтобы все работали с одной и той же копией.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "📞 Call with one click"
msgstr "📞 Вызов в один клик"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Need to talk? <strong>Start call</strong> notifies everyone in the conversation, and they join with one click. You can share your screen too.</p><p>No need to try it now: it would ring them all.</p>"
msgstr "<p>Нужно поговорить? Кнопка <strong>Начать вызов</strong> оповещает всех участников обсуждения, и они подключаются в один клик. Можно также показать свой экран.</p><p>Сейчас пробовать не нужно: звонок получат все.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "📅 Plan a meeting"
msgstr "📅 Запланируйте встречу"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Next to <strong>Start call</strong>, the calendar button lists upcoming meetings. <strong>Schedule a meeting</strong> puts one in your calendar and invites everyone here.</p><p>At meeting time, everyone opens this conversation and joins the call.</p>"
msgstr "<p>Кнопка с календарём рядом с <strong>Начать вызов</strong> показывает предстоящие встречи. <strong>Запланировать встречу</strong> добавляет встречу в ваш календарь и приглашает всех участников этого обсуждения.</p><p>В назначенное время все открывают это обсуждение и подключаются к вызову.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "🔔 Choose what you hear"
msgstr "🔔 Решите, о чём вас оповещать"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Each conversation has its own setting: hover over it, click the three dots and open <strong>Notifications</strong>. Put your team's conversation on <strong>All messages</strong>.</p><p>Someone chose <strong>@-mentions only</strong>? Type <strong>@</strong> and their name to reach them.</p>"
msgstr "<p>У каждого обсуждения свои параметры уведомлений: наведите на него указатель, нажмите на три точки и откройте <strong>Уведомления</strong>. Для обсуждения вашей команды выберите <strong>Все сообщения</strong>.</p><p>Кто-то выбрал <strong>Только @-упоминания</strong>? Введите <strong>@</strong> и имя этого человека, чтобы он увидел сообщение.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "🏠 Start your day at Home"
msgstr "🏠 Начинайте день с домашней страницы"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p><strong>Home</strong> shows your upcoming meetings, unread mentions and message reminders.</p><p>Search your phone's app store for Nextcloud Talk, so calls and messages reach you when this tab is closed.</p>"
msgstr "<p>Раздел <strong>Домашняя страница</strong> показывает предстоящие встречи, непрочитанные упоминания и напоминания о сообщениях.</p><p>Найдите Nextcloud Talk в магазине приложений на телефоне, чтобы вызовы и сообщения доходили до вас, даже когда эта вкладка закрыта.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Talk app; keep the emoji
msgid "🔍 A quick question?"
msgstr "🔍 Быстрый вопрос?"

#. TRANSLATORS: Text of a step in the built-in tour of the Talk app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Next time you have a quick question, type a colleague's name here to start a one-to-one chat. It also finds your conversations.</p><p>That's it. Send your next team update in your team conversation instead of an email.</p>"
msgstr "<p>Когда в следующий раз появится быстрый вопрос, введите здесь имя коллеги, чтобы начать личный чат. Здесь же можно найти и ваши обсуждения.</p><p>Вот и всё. Следующую новость для команды отправьте в обсуждение команды, а не по электронной почте.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "🗂️ Welcome to Deck"
msgstr "🗂️ Добро пожаловать в «Карточки»"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Deck keeps track of tasks, your own or your team's, so everyone sees who does what and what is due.</p><p>In this tour you add a task, give it a due date and see where it comes back.</p>"
msgstr "<p>«Карточки» помогают следить за задачами — вашими или вашей команды, — чтобы все видели, кто что делает и какие сроки.</p><p>В этой экскурсии вы добавите задачу, назначите ей срок и увидите, где она появится снова.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "📋 Open a board"
msgstr "📋 Откройте доску"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Your boards are listed here, together with boards colleagues share with you.</p><p>Click your <strong>Welcome</strong> board to practice: only you can see it. No Welcome board? Open a board of your own.</p>"
msgstr "<p>Здесь перечислены ваши доски, а также доски, которыми с вами поделились коллеги.</p><p>Для тренировки нажмите на свою доску <strong>Добро пожаловать</strong>: её видите только вы. Такой доски нет? Откройте любую свою доску.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "➕ Add a card"
msgstr "➕ Добавьте карточку"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Each column is a list, such as To do or Done, and each card is a task. Click the highlighted button to add one.</p><p>No button? You can only view this board, or it has no lists yet. Click <strong>Back</strong> and open another.</p>"
msgstr "<p>Каждая колонка — это список, например «К выполнению» или «Выполненные», а каждая карточка — задача. Нажмите выделенную кнопку, чтобы добавить карточку.</p><p>Кнопки нет? Значит, эту доску можно только просматривать или на ней ещё нет колонок. Нажмите <strong>Назад</strong> и откройте другую.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "✏️ What needs doing?"
msgstr "✏️ Что нужно сделать?"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Click in the field, type a real task, such as <em>Set up a board for my project</em>, and press <strong>Enter</strong>. Your card appears in the list and the field empties.</p><p>Only Enter saves it, so press Enter first, then click <strong>Next</strong>.</p>"
msgstr "<p>Щёлкните в поле, введите настоящую задачу, например <em>Создать доску для моего проекта</em>, и нажмите <strong>Enter</strong>. Карточка появится в колонке, а поле очистится.</p><p>Сохраняет её только Enter, поэтому сначала нажмите Enter, а затем — <strong>Далее</strong>.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "👆 Open your card"
msgstr "👆 Откройте карточку"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Your new card is at the bottom of the list. Click it to open it.</p><p>Later on, drag cards to the next list as the work moves on, and up or down to change their order.</p>"
msgstr "<p>Новая карточка находится внизу колонки. Нажмите на неё, чтобы открыть.</p><p>Позже, по мере продвижения работы, перетаскивайте карточки в следующую колонку, а вверх или вниз — чтобы изменить их порядок.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "📅 Give it a due date"
msgstr "📅 Назначьте срок"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Click the <strong>+</strong> here and pick a date. Cards with a due date come back in <strong>Upcoming cards</strong> and, if you use Calendar, in your calendar.</p><p>On a shared board, you can assign the card to someone in the field above; they get a notification.</p>"
msgstr "<p>Нажмите здесь <strong>+</strong> и выберите дату. Карточки со сроком появляются в разделе <strong>Предстоящие карточки</strong> и, если вы пользуетесь Календарём, в вашем календаре.</p><p>На общей доске карточку можно назначить кому-нибудь в поле выше — этот человек получит уведомление.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "💬 Notes, comments and files"
msgstr "💬 Заметки, комментарии и файлы"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Keep everything about a task on its card: notes and checklists in the description, discussion in the comments, files as attachments for everyone on the board. Type @ in a comment to mention someone.</p><p>Now close the card with ✕, then click <strong>Next</strong>.</p>"
msgstr "<p>Храните всё о задаче на её карточке: заметки и списки дел — в описании, обсуждение — в комментариях, файлы — во вложениях, доступных всем на доске. Чтобы упомянуть кого-то, введите @ в комментарии.</p><p>Теперь закройте карточку кнопкой ✕, затем нажмите <strong>Далее</strong>.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "🤝 Work together"
msgstr "🤝 Работайте вместе"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>This button opens the board's details: share the board with colleagues, groups or teams, and see who changed what.</p><p>People you add can only view at first. Turn on <strong>Can edit</strong> for those who work on the cards.</p>"
msgstr "<p>Эта кнопка открывает свойства доски: здесь можно поделиться доской с коллегами, группами или командами и посмотреть, кто что изменил.</p><p>Добавленные люди сначала могут только просматривать доску. Включите <strong>Разрешить редактировать</strong> для тех, кто работает с карточками.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "📆 Upcoming cards"
msgstr "📆 Предстоящие карточки"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Now see your task come back: click <strong>Upcoming cards</strong>. It gathers the open cards from all your boards in one view.</p>"
msgstr "<p>Теперь посмотрите, где снова появится ваша задача: нажмите <strong>Предстоящие карточки</strong>. Здесь в одном представлении собраны открытые карточки со всех ваших досок.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "⏰ What's due when"
msgstr "⏰ Что и к какому сроку"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Your open cards from every board, assigned to you or to no one, sorted by due date. Find your new card under the day you picked, or under <strong>No due</strong>.</p><p>Finished? Click <strong>Mark as done</strong> on its card, and it leaves this list.</p>"
msgstr "<p>Ваши открытые карточки со всех досок, назначенные вам или никому, отсортированы по сроку. Найдите новую карточку под выбранным днём или в группе <strong>Без срока</strong>.</p><p>Задача выполнена? Нажмите <strong>Отметить как выполненную</strong> на её карточке, и она исчезнет из этого списка.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Deck app; keep the emoji
msgid "🚀 Make it yours"
msgstr "🚀 Настройте под себя"

#. TRANSLATORS: Text of a step in the built-in tour of the Deck app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>That's it. Ready for real work? Add a board for each project or team, give it your own lists and share it with the people involved.</p><p>The cards on the Welcome board have more tips.</p>"
msgstr "<p>Вот и всё. Готовы к настоящей работе? Создайте доску для каждого проекта или команды, добавьте на неё свои колонки и поделитесь ею с теми, кто участвует в работе.</p><p>Больше советов — на карточках доски «Добро пожаловать».</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "📅 Welcome to Calendar"
msgstr "📅 Добро пожаловать в Календарь"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Plan meetings and time for your own work, and see when colleagues are free.</p><p>In this tour you plan an event, then see how to invite colleagues, share calendars and have them on your phone too.</p>"
msgstr "<p>Планируйте встречи и время для собственной работы и смотрите, когда коллеги свободны.</p><p>В этой экскурсии вы запланируете событие, а затем увидите, как приглашать коллег, делиться календарями и пользоваться ими на телефоне.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "➕ Plan your first event"
msgstr "➕ Запланируйте первое событие"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Let's plan something: click the highlighted button to start a new event.</p><p>Later you can also click a day in the calendar, or drag across a few hours in the week view.</p>"
msgstr "<p>Давайте что-нибудь запланируем: нажмите выделенную кнопку, чтобы создать событие.</p><p>Позже можно также нажать на день в календаре или выделить мышью несколько часов в представлении недели.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "👥 Meeting with others?"
msgstr "👥 Встреча с другими?"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Add colleagues, or anyone by email, under <strong>Attendees</strong>. Once they are added, <strong>Find a time</strong> in <strong>More details</strong> shows when they are free. Reminders are there too.</p><p>To invite people, your account needs an email address. First, the basics.</p>"
msgstr "<p>Добавьте коллег или кого угодно по адресу электронной почты в разделе <strong>Участники</strong>. После этого <strong>Найди время</strong> в разделе <strong>Подробнее</strong> покажет, когда они свободны. Там же настраиваются напоминания.</p><p>Чтобы приглашать людей, в вашей учётной записи должен быть указан адрес электронной почты. Но сначала — основное.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "✏️ What and when"
msgstr "✏️ Что и когда"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Plan something real: type what it is, such as <em>Project meeting</em> or <em>Writing time</em>.</p><p>Then set the day and time just below it, and click <strong>Next</strong>.</p>"
msgstr "<p>Запланируйте что-нибудь настоящее: введите, что это, например <em>Встреча по проекту</em> или <em>Время для работы над текстом</em>.</p><p>Затем чуть ниже задайте день и время и нажмите <strong>Далее</strong>.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "💾 Save it"
msgstr "💾 Сохраните"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Click <strong>Save</strong>, and your event is in your calendar. Later, click it to see or edit it, or drag it to another day or time.</p><p>Rather not keep it? Close it with ✕, then click <strong>Next</strong>.</p>"
msgstr "<p>Нажмите <strong>Сохранить</strong>, и событие появится в вашем календаре. Позже нажмите на него, чтобы посмотреть или изменить, или перетащите на другой день или время.</p><p>Не хотите сохранять? Закройте окно кнопкой ✕, затем нажмите <strong>Далее</strong>.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "🧭 Day, week or month"
msgstr "🧭 День, неделя или месяц"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Planned it for another week or month? The arrows above take you there; click the date between them to jump to any day. <strong>Today</strong> brings you back.</p><p>This menu switches between day, week, month, year and a list.</p>"
msgstr "<p>Запланировали на другую неделю или месяц? Перейти туда помогут стрелки вверху; нажмите на дату между ними, чтобы перейти к любому дню. Кнопка <strong>Сегодня</strong> вернёт вас обратно.</p><p>Это меню переключает вид: день, неделя, месяц, год или список.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "☑️ Your calendars"
msgstr "☑️ Ваши календари"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Click a calendar to show or hide its events. You may also see birthdays, Deck cards with a due date and calendars shared with you.</p><p>To share one, hover over it and choose <strong>Edit and share calendar</strong>.</p>"
msgstr "<p>Нажмите на календарь, чтобы показать или скрыть его события. Здесь также могут быть дни рождения, карточки со сроком из приложения «Карточки» и календари, которыми с вами поделились.</p><p>Чтобы поделиться календарём, наведите на него указатель и выберите <strong>Редактировать и делиться календарем</strong>.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "📆 Calendars for projects and teams"
msgstr "📆 Календари для проектов и команд"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Make a separate calendar for a project or team, and share it with them.</p><p>If your organization allows it, you can also subscribe to a read-only calendar by link, such as a course timetable, or add public holidays.</p>"
msgstr "<p>Создайте отдельный календарь для проекта или команды и поделитесь им с её участниками.</p><p>Если ваша организация это разрешает, можно также подписаться по ссылке на календарь только для чтения, например расписание занятий, или добавить государственные праздники.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "📱 On your phone too"
msgstr "📱 И на телефоне"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p><strong>Calendar settings</strong> has the CalDAV address for your phone or Thunderbird, and a separate one for iPhone and Mac. On Android, use the DAVx⁵ app.</p><p>Sign in there with an app password, made in your personal settings under <strong>Security</strong>.</p>"
msgstr "<p>В разделе <strong>Параметры календаря</strong> есть адрес CalDAV для телефона или Thunderbird и отдельный адрес для iPhone и Mac. На Android используйте приложение DAVx⁵.</p><p>Входите там с паролем приложения, который создаётся в личных параметрах в разделе <strong>Безопасность</strong>.</p>"

#. TRANSLATORS: Title of a step in the built-in tour of the Calendar app; keep the emoji
msgid "🕓 Let others book time with you"
msgstr "🕓 Пусть другие записываются к вам"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>For office hours, supervision or study participants: an appointment schedule gives people a link to book a free slot with you, no account needed.</p><p>See a warning here? Your account needs an email address; ask your IT team if you cannot add one.</p>"
msgstr "<p>Для приёмных часов, консультаций или участников исследования: расписание встреч даёт людям ссылку, по которой они могут записаться к вам на свободное время без учётной записи.</p><p>Видите здесь предупреждение? В вашей учётной записи должен быть указан адрес электронной почты; если не получается его добавить, обратитесь в ИТ-отдел.</p>"

#. TRANSLATORS: Text of a step in the built-in tour of the Calendar app. Words in bold are labels in Nextcloud: use the words Nextcloud shows in your language
msgid "<p>Deleted an event by mistake? It stays in the <strong>Trash bin</strong> for a while, so you can restore it.</p><p>That's it. Now plan your next real meeting here, and invite the people involved.</p>"
msgstr "<p>Случайно удалили событие? Оно ещё какое-то время хранится в разделе <strong>Корзина</strong>, и его можно восстановить.</p><p>Вот и всё. Теперь запланируйте здесь свою следующую настоящую встречу и пригласите её участников.</p>"

#. TRANSLATORS: Checklist task on the Dashboard; the Dashboard cuts off text longer than one line
msgid "Take the welcome tour"
msgstr "Пройти вводную экскурсию"

#. TRANSLATORS Menu entry and checklist task: upload a file from your computer (src/admin/ToursList.vue:22)
msgid "Upload a file"
msgstr "Загрузить файл"

#. TRANSLATORS: Checklist task on the Dashboard; the Dashboard cuts off text longer than one line
msgid "Add a profile picture"
msgstr "Добавить изображение профиля"

#. TRANSLATORS: Checklist task on the Dashboard: install the Nextcloud desktop or mobile app; keep it short
msgid "Install the app"
msgstr "Установить приложение"

msgid "Send a message in Talk"
msgstr "Отправить сообщение в «Конференциях»"

#. TRANSLATORS: Checklist task on the Dashboard; the Dashboard cuts off text longer than one line
msgid "Secure your account"
msgstr "Защитить учётную запись"

msgid "A short tour of Nextcloud"
msgstr "Короткая экскурсия по Nextcloud"

msgid "Drag a file into Files, or use New"
msgstr "Перетащите файл в Файлы или нажмите «Новый»"

#. TRANSLATORS: Short explanation under the task "Add a profile picture"; keep it short
msgid "So others recognize you"
msgstr "Чтобы другие вас узнавали"

msgid "On your computer or phone"
msgstr "На компьютере или телефоне"

msgid "Chat and call with your team"
msgstr "Общайтесь и созванивайтесь с командой"

#. TRANSLATORS: Short explanation under the task "Secure your account"; keep it short
msgid "With two-factor authentication"
msgstr "С помощью двухфакторной аутентификации"

msgid "While the welcome tour is on"
msgstr "Пока включена вводная экскурсия"

msgid "For people who can use Talk"
msgstr "Для тех, кому доступны «Конференции»"

msgid "When an app for two-factor authentication is installed"
msgstr "Если установлено приложение для двухфакторной аутентификации"

#. TRANSLATORS: Title of the first step of the welcome tour; keep the emoji
msgid "👋 Welcome to Nextcloud"
msgstr "👋 Добро пожаловать в Nextcloud"

msgid "<p>Nice to have you here! This short tour will help you get started quickly.</p><p>You can close this wizard at any time and open it again later.</p>"
msgstr "<p>Рады вас видеть! Эта короткая экскурсия поможет быстро освоиться.</p><p>Закрыть её можно в любой момент и открыть позже снова.</p>"

#. TRANSLATORS: Title of a step of the welcome tour; keep the emoji
msgid "📁 Files & apps"
msgstr "📁 Файлы и приложения"

msgid "<p>Files is where you view and manage everything you store.</p><p>You will find it in the apps menu (top left) — together with Calendar, Mail, Contacts and more. Click the menu any time to switch apps.</p>"
msgstr "<p>Здесь, в разделе Файлы, вы просматриваете и упорядочиваете всё, что храните.</p><p>Меню приложений (вверху слева) открывает остальные — Календарь, Почту, Контакты и другие. Нажмите на меню в любой момент, чтобы переключиться.</p>"

#. TRANSLATORS: Noun: title of a step of the welcome tour about the search; keep the emoji
msgid "🔍 Search"
msgstr "🔍 Поиск"

msgid "<p>With the search bar you can quickly find files, contacts and more.</p><p>Just type what you're looking for and press Enter.</p>"
msgstr "<p>Строка поиска быстро находит файлы, контакты и многое другое.</p><p>Введите, что ищете, и нажмите Enter.</p>"

msgid "⚙️ Your account & settings"
msgstr "⚙️ Учётная запись и параметры"

msgid "<p>Your profile, personal settings and the log out button live under your avatar (top right).</p><p>Click it whenever you want to adjust your account.</p>"
msgstr "<p>Профиль, личные параметры и кнопка выхода находятся под вашим аватаром (вверху справа).</p><p>Нажмите на него, когда понадобится изменить учётную запись.</p>"

#. TRANSLATORS: Title of a step of the welcome tour; keep the emoji
msgid "🎯 Getting started"
msgstr "🎯 Начало работы"

#. TRANSLATORS: Text of a step in the welcome tour. Words in bold are names in Nextcloud: use the words Nextcloud shows in your language
msgid "<p><strong>Nextcloud is your personal cloud storage!</strong></p><p>Here you can:</p><ul><li>📁 Upload, share and collaborate on files</li><li>📅 Manage your calendar</li><li>✉️ Send and receive email</li><li>👥 Keep track of contacts</li></ul>"
msgstr "<p><strong>Nextcloud — ваше личное облачное хранилище!</strong></p><p>Здесь можно:</p><ul><li>📁 Загружать файлы, делиться ими и работать над ними вместе</li><li>📅 Вести календарь</li><li>✉️ Отправлять и получать электронную почту</li><li>👥 Хранить контакты</li></ul>"

#. TRANSLATORS: Title of a step of the welcome tour; keep the emoji
msgid "✨ Important features"
msgstr "✨ Главные возможности"

#. TRANSLATORS: Text of a step in the welcome tour. Words in bold are names in Nextcloud: use the words Nextcloud shows in your language
msgid "<p><strong>Finding your way around:</strong></p><ul><li>Use the <strong>apps menu</strong> (top left) to switch between apps</li><li>Open your <strong>avatar</strong> (top right) for your account and settings</li><li>Use the <strong>search bar</strong> to quickly find files and more</li></ul>"
msgstr "<p><strong>Как ориентироваться:</strong></p><ul><li>Переключайтесь между приложениями через <strong>меню приложений</strong> (вверху слева)</li><li>Учётная запись и параметры открываются через <strong>аватар</strong> (вверху справа)</li><li>Файлы и многое другое быстро находит <strong>строка поиска</strong></li></ul>"

#. TRANSLATORS: Title of a step of the welcome tour; keep the emoji
