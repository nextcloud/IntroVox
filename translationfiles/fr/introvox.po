msgid "Switch {tour} on or off"
msgstr "Activer ou désactiver {tour}"

#. TRANSLATORS Button: opens the steps of a tour (src/admin/ToursList.vue:69)
msgid "Edit steps"
msgstr "Modifier les étapes"

#. TRANSLATORS Invisible label of a menu button with more actions; {tour} is the name of a tour, such as "Talk" (src/admin/ToursList.vue:72)
msgid "More for {tour}"
msgstr "Plus d’actions pour {tour}"

#. TRANSLATORS Menu entry (verb): shows the tour as users get it (src/admin/ToursList.vue:77)
msgid "Preview"
msgstr "Prévisualiser"

#. TRANSLATORS Menu entry: copies a link that starts the tour (src/admin/ToursList.vue:83)
msgid "Copy link"
msgstr "Copier le lien"

#. TRANSLATORS Menu entry: downloads the tour as a file (src/admin/ToursList.vue:89)
msgid "Export tour"
msgstr "Exporter la visite"

#. TRANSLATORS Menu entry and dialog title: everyone who saw the tour gets it once more (src/admin/ToursList.vue:95)
