{
  "name": "nextcloud-introvox",
  "version": "2.0.0",
  "description": "Interactive onboarding tour for new Nextcloud users",
  "repository": {
    "type": "git",
    "url": "https://github.com/nextcloud/IntroVox.git"
  },
  "author": "Shalution",
  "license": "AGPL-3.0",
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "deploy": "npm run build && ./deploy.sh",
    "test:js": "node --test tests-js/*.test.js",
    "test:php": "php tests-php/run.php",
    "l10n:extract": "node scripts/extract-en-json.js",
    "l10n:lint": "node scripts/lint-l10n-strings.js",
    "pot": "npm run l10n:extract && node scripts/generate-pot.js",
    "l10n:push": "npm run l10n:extract && node scripts/lint-l10n-strings.js && node scripts/generate-pot.js",
    "lint:l10n": "node scripts/check-l10n-sync.js",
    "prebuild": "node scripts/check-l10n-sync.js"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.4.0",
    "@nextcloud/dialogs": "^7.1.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.0",
    "@nextcloud/paths": "^2.3.0",
    "@nextcloud/router": "^3.0.0",
    "@nextcloud/vue": "^9.2.0",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vue/compiler-sfc": "^3.5.22",
    "cancelable-promise": "^4.3.1",
    "dompurify": "^3.4.17",
    "shepherd.js": "^11.2.0",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.22",
    "vue-loader": "^17.4.2",
    "vue-material-design-icons": "^5.3.1"
  },
  "devDependencies": {
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
